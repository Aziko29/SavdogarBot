# ===== Telegram =====
# Bot token from @BotFather
BOT_TOKEN=<bot token>
# Main admin's Telegram user ID (the client). Gets the full admin panel plus the "Adminlar" section
# where other admins are added/removed inside the bot. Changeable only here (server side).
BOSH_ADMIN_ID=<123456789>
# Server owner's Telegram user ID (optional). Receives the bot's log files; grants NO admin-panel
# access by itself. The owner must press Start in the bot once, otherwise nothing can be delivered.
# OWNER_ID=123456789
# How often (hours, 1-168) the new log lines are sent to the owner; 0 turns it off. Default 24.
# LOG_SEND_HOURS=24
# The source channel and the posting channel/group are NOT set here: the head admin adds the bot
# to them and picks the role inside the bot (/admin -> Kanal va guruhlar).

# ===== General =====
# Database. Default: a local SQLite file (async driver required).
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# PostgreSQL (recommended on Render, whose free disk is wiped on every restart): paste the provider's
# connection string as it is; 'postgres://' and 'postgresql://' are converted automatically. Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local TCP port used as the single-instance lock. Every bot on the same server needs its own
# port (47400, 47401, ...); leave unset for 47400.
# LOCK_PORT=47400
# IANA time zone used for night mode and daily counters
TZ=Asia/Tashkent
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# ===== Gemini (primary AI) =====
# Priority group 1: comma-separated API keys
GEMINI_API_KEYS=<key1,key2>
# Optional fallback groups, used when the previous group is exhausted
# GEMINI_API_KEYS_2=<key3>
# GEMINI_API_KEYS_3=<key4>
# Models in priority order (verify current model names before filling)
GEMINI_MODELS=<fill current model names>

# ===== Fallback providers (OpenAI-compatible) =====
# Providers in priority order: groq, openrouter, openai, qwen or any custom name
# FALLBACK_PROVIDERS=groq,openrouter
# For every listed provider NAME: NAME_API_KEYS, NAME_MODELS and optionally NAME_BASE_URL
# GROQ_API_KEYS=<key1,key2>
# GROQ_MODELS=<fill current model names>
# OPENROUTER_API_KEYS=<key1>
# OPENROUTER_MODELS=<fill current model names>
# Custom provider example (base URL is mandatory for unknown names)
# MYPROVIDER_BASE_URL=https://api.example.com/v1

# ===== AI router tuning =====
# Parallel AI workers
AI_WORKERS=2
# Max product IDs waiting in the queue
QUEUE_MAXSIZE=200
# Timeout of one AI attempt, seconds
AI_ATTEMPT_TIMEOUT_SEC=20
# Total time budget for one AI call across all attempts, seconds
AI_OVERALL_BUDGET_SEC=60
# How long a key stays excluded after all its models hit quota, minutes
KEY_EXHAUSTED_MINUTES=15
# Fallback models are used with images only if the model name contains one of these
VISION_MODEL_HINTS=vision,llama-4,scout,maverick,gemini,gpt-4o,-vl,qwen2.5-vl

# ===== Posting =====
# Minimum hours before the same product is posted again
MIN_REPOST_GAP_HOURS=6
# Do not repeat any of the last N posted products
NO_REPEAT_LAST_N=3
# Longest photo side sent to the AI, pixels
PHOTO_MAX_SIDE=1600
# Seconds to wait for the remaining photos of an album
ALBUM_WAIT_SEC=3
# Hours the bot stays in a channel/group the head admin has not registered; then it leaves (0.1-168)
FOREIGN_CHAT_GRACE_HOURS=6
